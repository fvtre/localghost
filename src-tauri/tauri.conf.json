{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalGhost",
  "version": "0.1.0",
  "identifier": "dev.localghost.desktop",
  "build": {
    "beforeDevCommand": "pnpm exec next dev --port 3001",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [{ "title": "LocalGhost", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
